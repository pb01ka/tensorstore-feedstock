@@ -25,9 +25,29 @@
     maybe(
         http_archive,
         name = "rules_cc",
-        urls = mirror_url("https://github.com/bazelbuild/rules_cc/archive/0.2.19.tar.gz"),
-        strip_prefix = "rules_cc-0.2.19",
-        sha256 = "351248f6be41d18694d4d7c390aaebd9f865eea72a4758b2c9d782ae744c97f4",
+        # Pinned to rules_cc 0.2.10 on Windows. tensorstore's WORKSPACE
+        # calls rules_cc's compatibility_proxy_repo() unconditionally, which
+        # 0.2.x has and 0.1.x doesn't -- but 0.2.19 (tensorstore's normal
+        # pin) implements cc_library/cc_binary/etc as pure Starlark rules
+        # built on cc_common.internal_DO_NOT_USE(), and on this Bazel build
+        # that private API comes back missing several methods it expects
+        # (freeze, create_header_info, ...) -- an upstream incompatibility,
+        # still open as bazelbuild/rules_cc#814 and #809. 0.2.10 predates
+        # that rewrite entirely (no references to cc_internal or
+        # internal_DO_NOT_USE anywhere in the release) while still having
+        # compatibility_proxy_repo() and the toolchain_config_utils.bzl
+        # helpers Bazel's own windows_cc_configure.bzl needs -- its
+        # compatibility_proxy_repo() picks plain native.cc_library() et al.
+        # on any Bazel below 9.0.0-pre, which is what actually avoids this
+        # class of bug (not the specific rules_cc version by itself). Other
+        # platforms never exercise any of this: bazel-toolchain's
+        # --crosstool_top flag routes them through Bazel's legacy
+        # CROSSTOOL-based toolchain resolution, bypassing rules_cc's
+        # Starlark cc_common machinery altogether. Windows has no such flag
+        # (see build.bat), so it takes this path instead.
+        urls = mirror_url("https://github.com/bazelbuild/rules_cc/archive/0.2.10.tar.gz"),
+        strip_prefix = "rules_cc-0.2.10",
+        sha256 = "774fd6cb9f90f98f1d26c776896b16a517a1af65337fcfaa705261df175f04a6",
         repo_mapping = {
             "@protobuf": "@com_google_protobuf",
         },
